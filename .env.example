# CodeCortex — environment variable reference
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Embedding provider ─────────────────────────────────────────────────────
# Options: stub | local | openai
CODECORTEX_EMBEDDING_PROVIDER=stub

# Required only when CODECORTEX_EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# ── Storage ────────────────────────────────────────────────────────────────
# Directory for graph snapshots, FAISS indices, and SQLite caches
CODECORTEX_CACHE_DIR=.codecortex/

# ── Logging ────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
CODECORTEX_LOG_LEVEL=WARNING

# ── Visualization server ───────────────────────────────────────────────────
CODECORTEX_VIZ_PORT=7979
